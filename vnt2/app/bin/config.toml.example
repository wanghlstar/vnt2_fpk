# ═══════════════════════════════════════════════════════
# VNT2 客户端配置文件
# 取消下面【必填项】的注释并填写后保存，应用会自动启动组网
# ═══════════════════════════════════════════════════════

# ─── 必填项 ───

# 组网编号：相同编号的设备会组在同一个虚拟局域网
# network_code = "123456"

# 服务端地址：协议支持 quic / tcp / wss / dynamic，可配置多个
# 公共服务端示例：quic://101.35.230.139:6660
# 自建服务端示例：quic://192.168.1.10:29872
# server = ["quic://101.35.230.139:6660"]

# ─── 可选项（不需要的保持注释状态即可）───

# 组网密码：设置后节点之间数据端到端加密，同一组网的所有设备需保持一致
# password = ""

# 自定义虚拟IP，留空则由服务端分配
# ip = ""

# 设备ID：不使用ip参数时服务端凭此分配虚拟ip，建议填写防止重启后虚拟ip变化
# device_id = ""

# 设备名称，留空则使用主机名
# device_name = "飞牛NAS"

# 虚拟网卡模式：no（无网卡，仅流量出口和端口映射）/ tun（三层网卡，默认）/ tap（二层网卡）
# device_mode = "tun"

# 虚拟网卡名称
# tun_name = "vnt-tun"

# 虚拟网卡MTU
# mtu = 1400

# 启用quic优化传输，提升弱网环境下的流量稳定性
# rtx = true

# 启用LZ4压缩
# compress = false

# 启用FEC前向纠错，损失一定带宽提升稳定性
# fec = false

# 关闭P2P打洞，全部流量走服务端中继
# no_punch = false

# 关闭内置子网NAT，点对网性能更好（需自行配置网卡转发）
# no_nat = false

# 控制服务端口（应用页面的信息查询依赖此服务），0表示禁用
# ctrl_port = 11233

# P2P隧道端口，0表示自动分配
# tunnel_port = 0

# 证书校验方式：skip（跳过验证，默认）/ standard（系统证书验证）/ finger:证书指纹
# 证书指纹为服务端启动时日志输出的64位十六进制，例如：
# cert_mode = "finger:3bdd8675606837cdf95d5e13445606315762315a78555f9da652940a25feaec1"

# 点对网入栈监听网段：网段,目标虚拟IP
# input = ["192.168.3.0/24,10.26.0.3"]

# 点对网出栈允许网段
# output = ["192.168.0.0/24"]

# 端口映射：协议://本地监听地址-目标虚拟IP-目标映射地址
# port_mapping = ["tcp://0.0.0.0:81-10.26.0.2-192.168.1.10:80"]

# 允许作为端口映射出口
# allow_mapping = false

# 绑定对外通信Socket的出口网卡名称，多WAN接入时需要指定
# outbound_interface = ""

# 自定义stun地址
# udp_stun = ["stun.chat.bilibili.com"]
# tcp_stun = ["stun.nextcloud.com:443"]
